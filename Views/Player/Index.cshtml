@model IEnumerable<Player>

<h2>Jugadores del Fútbol Peruano</h2>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Edad</th>
            <th>Posición</th>
            <th>Equipo Actual</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var player in Model)
        {
            <tr>
                <td>@player.Name</td>
                <td>@player.Age</td>
                <td>@player.Position</td>
                <td>
                    @player.PlayerTeams?.FirstOrDefault(pt => pt.IsCurrent)?.Team?.Name
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Nuevo Jugador</a>